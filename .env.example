# DevFlow Environment Configuration Template

# Optional AI Assistant API Key (Leave blank to use local offline engine)
DEVFLOW_AI_API_KEY=

# Optional AI Assistant custom endpoint & model
DEVFLOW_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
DEVFLOW_AI_MODEL=gpt-4o-mini

# Optional Logging verbosity (debug, info, warn, error)
DEVFLOW_LOG_LEVEL=info
