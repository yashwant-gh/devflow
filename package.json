{
  "name": "devflow-toolkit",
  "version": "1.0.1",
  "description": "Build smarter. Standardize everything. Ship with confidence. DevFlow is an extensible developer workflow automation platform.",
  "type": "module",
  "bin": {
    "devflow": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.js",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "devflow",
    "cli",
    "developer-experience",
    "scaffolding",
    "ci-cd",
    "standards",
    "code-quality",
    "devops",
    "docker",
    "automation"
  ],
  "author": "DevFlow Engineering Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashwant-gh/devflow.git"
  },
  "bugs": {
    "url": "https://github.com/yashwant-gh/devflow/issues"
  },
  "homepage": "https://github.com/yashwant-gh/devflow#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.4.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.3.6",
    "ora": "^8.1.0",
    "semver": "^7.6.3",
    "table": "^6.8.2",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
